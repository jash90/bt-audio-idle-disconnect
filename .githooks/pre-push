#!/usr/bin/env bash
# Runs scripts/ci.sh before every push. Opt in with: git config core.hooksPath .githooks
# Skip once with: SKIP_CI_HOOK=1 git push   (or git push --no-verify)
set -euo pipefail
if [ "${SKIP_CI_HOOK:-0}" = "1" ]; then
    echo "pre-push: SKIP_CI_HOOK=1 — skipping scripts/ci.sh"
    exit 0
fi
exec "$(git rev-parse --show-toplevel)/scripts/ci.sh"
